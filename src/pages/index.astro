---
// src/pages/index.astro - the v3 Astro shell.
//
// V3 reimplements the 2020 grayscale visual language (see /DESIGN.md)
// over the same canonical content/profile.json this page has rendered
// since Task 1. content/profile.json stays the single source of truth
// for both the human surface (this page) and the agent surfaces
// (llms.txt, api/profile.json), so the two audiences cannot drift
// apart. This task changes only presentation: the frontmatter logic
// below - validation, URL scheme checks, JSON-LD construction - is
// unchanged from Task 1/2.
//
// The load-bearing requirement here is the VISIBLE current-role line.
// A controlled test found five major AI agents (ChatGPT, Claude,
// Perplexity, Gemini, Copilot) all missed employer data that existed
// only inside a <script type="application/ld+json"> block - so the
// JSON-LD below is additive, never the only place "Apple" appears.
import '../styles/tokens.css'
import profile from '../../content/profile.json'
import { validateUrl } from '../lib/url'
import { buildJsonLd } from '../lib/jsonLd'
import { validateProfile } from '../lib/validateProfile'
import { resolveLastUpdated } from '../lib/lastUpdated'

// Whole-document invariants that no single-value render call can
// catch (duplicate project slugs, a malformed email) - ported from
// v1's validate_profile(). Runs before anything below reads `profile`,
// so a violation aborts the build before any output is written, rather
// than shipping a page with broken aria-labelledby wiring or a
// poisoned mailto: link. See src/lib/validateProfile.ts.
validateProfile(profile)

const { site, person, about, projects, experience } = profile
const currentRole = person.current_role

// Every URL sink on this page runs through validateUrl() before it
// reaches an href or a JSON-LD block - ported from build.py's
// validate_url()/esc_url() split after a v1 code-review MUST FIX:
// html.escape() (and Astro's equivalent automatic attribute escaping)
// neutralizes quotes and angle brackets, but performs no scheme
// validation, so a "javascript:" or "data:" URL survives escaping
// intact and executes on click. validateUrl() throws and aborts the
// build on a disallowed scheme rather than silently defanging the
// link - see src/lib/url.ts.
//
// Computed once up front so the SAME normalized string is used
// everywhere a value appears twice (e.g. site.url in both the
// canonical link and JSON-LD's "url" field; person.profiles[].url in
// both the visible social nav and JSON-LD's "sameAs").
const siteUrl = validateUrl(site.url, 'site.url')
const resumeUrl = validateUrl(person.resume.url, 'person.resume.url')
const validatedProfiles = (person.profiles ?? []).map((profileLink) => ({
  ...profileLink,
  url: validateUrl(profileLink.url, 'person.profiles[].url'),
}))
const validatedProjects = (projects ?? []).map((project) => ({
  ...project,
  links: (project.links ?? []).map((link) => ({
    ...link,
    url: validateUrl(link.url, 'projects[].links[].url'),
  })),
}))
const featuredProjects = validatedProjects.filter((project) => project.featured)

// The non-featured remainder is split by era. With twelve projects, one
// undifferentiated "Also" list runs nine rows deep and a reader
// scanning for current work has to date-check each one.
//
// EARLY_ERA_SLUGS is an explicit list rather than a parse of `period`,
// deliberately: `period` is a human-readable string ("2026", "Apr 2020
// - Jun 2020", "May 2019") with no guaranteed shape, so parsing it here
// would make the LAYOUT a second source of truth about when a project
// happened. An explicit list fails visibly - a slug typo drops the
// project into the wrong group where it can be seen - whereas a failed
// date parse would silently mis-sort.
const EARLY_ERA_SLUGS = new Set([
  'predicting-disease-risk',
  'weather-forecast-iot',
  'music-master',
  'facebook-data-challenge',
])
const otherProjects = validatedProjects.filter(
  (project) => !project.featured && !EARLY_ERA_SLUGS.has(project.slug),
)
const earlyProjects = validatedProjects.filter(
  (project) => !project.featured && EARLY_ERA_SLUGS.has(project.slug),
)

// Rendered by ONE markup block below rather than two copied ones. A
// second hand-copied <article class="project-row"> would be free to
// drift from the first - dropping the stack list or the links - and
// nothing would catch it.
const projectGroups = [
  { label: 'Also', items: otherProjects },
  { label: 'Earlier work, 2019 to 2020', items: earlyProjects },
]

// person.education is rendered as visible text in the About band
// below (a <p class="band__meta">), not just inside the JSON-LD
// alumniOf block - the exact failure shape the visible-current-role-
// line rule above exists to prevent, just for a different field. A
// controlled test found five major AI agents all missed data that
// existed only inside JSON-LD, so it is sourced from profile.json
// rather than hardcoded, and its URL runs through the same
// validateUrl() gate as every other href on this page.
const educationUrl = person.education?.institution_url
  ? validateUrl(person.education.institution_url, 'person.education.institution_url')
  : null

/**
 * Format an experience entry's date range the same way v1 does:
 * "YYYY-MM - YYYY-MM", or "YYYY-MM - Present" for a still-current role
 * (end is null). Always a plain hyphen surrounded by spaces, never an
 * em dash - the repo owner's standing style rule applies here too.
 */
function formatDateRange(start: string, end: string | null): string {
  return `${start} - ${end ? end : 'Present'}`
}

// The freshness signal shared by JSON-LD's dateModified and
// sitemap.xml's lastmod: the git commit date of HEAD, falling back to
// profile._meta.last_updated when no git history is available (a
// shallow CI clone or a tarball build). Resolved once here, at the
// human page's build time, rather than inside buildJsonLd() itself, so
// that function stays pure and unit-testable with an injected value -
// see src/lib/lastUpdated.ts.
const lastUpdated = resolveLastUpdated(profile)

// Built by src/lib/jsonLd.ts's buildJsonLd() - a schema.org Person
// object built directly from the same content model, so the
// agent-legible structured data and the visible page can never
// describe two different people. Extracted to a standalone module
// (rather than constructed inline here) specifically so every URL sink
// it emits - worksFor.url, url, sameAs, and alumniOf.url - is covered
// by tests/jsonLd.test.ts; an inline object literal in this frontmatter
// is not importable by a test at all, which is how a missing
// validateUrl() call on person.education.institution_url went
// undetected in the first pass of this port.
const jsonLd = buildJsonLd(profile, lastUpdated)

// Serialize, then guard against a </script> breakout the same way
// build.py's render_json_ld_script() does: any "</" sequence (which can
// only occur inside a string value - JSON's structural characters never
// include "<") becomes "<\/", a valid JSON escape for a bare "/", so
// JSON.parse() on the embedded text still recovers the exact original
// string. This is what the round-trip test in build.py's own test
// suite verifies, and the same property holds here.
const jsonLdScript = JSON.stringify(jsonLd, null, 2).replace(/<\//g, '<\\/')
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="author" content={person.name} />
    <meta name="theme-color" content={site.theme_color} />
    <link rel="canonical" href={siteUrl} />
    <!--
      The markdown twin of this page (src/pages/index.md.ts), built
      from the same content/profile.json content model. A markdown page
      costs roughly 80% fewer tokens for an agent to read than this
      rendered HTML page, and outperforms llms.txt alone for a question
      answered by this specific page's content.
    -->
    <link rel="alternate" type="text/markdown" href="/index.md" />
    <!--
      Root-relative because this is a GitHub Pages USER site served from
      the domain root (base: '/', not a repo-name subpath). The file
      itself lives in public/favicon.svg, which Astro copies verbatim
      to dist/favicon.svg at build time - it is the same monogram v1
      shipped from assets/favicon.svg, not redrawn.
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={site.title} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />

    <script type="application/ld+json" set:html={jsonLdScript} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-nav-bar">
      <div class="site-nav-bar__inner">
        <a class="site-nav-bar__brand" href="#">{person.name}</a>
        <nav aria-label="Primary" class="site-nav" id="site-nav">
          <a href="#about">About</a>
          <a href="#experience">Experience</a>
          <a href="#projects">Projects</a>
          <a href="#contact">Contact</a>
        </nav>
        {/*
          Appears exactly where .site-nav's links leave (960px), so the
          header is never left without navigation. type="button" is
          required - a bare <button> defaults to submit. State lives on
          aria-expanded, which initNavMenu keeps in sync; the control is
          a real <button>, never an <a> (aria-pressed on an <a> is an
          axe-confirmed aria-allowed-attr violation, impact critical -
          that exact bug shipped here on 2026-07-30).
        */}
        <button
          class="nav-hamburger"
          id="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Toggle navigation menu"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
        <div class="topbar__utility">
          <a class="topbar__resume" href={resumeUrl} rel="noopener" target="_blank">
            {person.resume.label}
          </a>
          {/*
            Ships as a plain link: no aria-pressed, no role. Both are
            invalid on the implicit role=link of an <a href> and axe
            flags aria-pressed here as aria-allowed-attr, impact
            critical. initViewToggle upgrades this into a real button
            (role, aria-pressed, Space activation) at init time, so
            the attributes exist only when the scripting that makes
            them true is actually running. The label is constant;
            state is carried by the dot, the border, and aria-pressed.
          */}
          <a
            class="topbar__view-toggle"
            data-view-toggle
            href="/index.md"
            title="See the markdown representation this page serves to AI agents"
          >agent view</a>
        </div>
      </div>
    </header>

    {/*
      Deliberately OUTSIDE [data-view-target]. Toggling replaces every
      child of <main>, so a live region nested inside it would be
      destroyed by the very swap it exists to announce.
    */}
    <p class="visually-hidden" role="status" data-view-status></p>

    <main id="main-content" data-view-target>
      <section id="hero" class="photo-band hero" aria-label="Introduction">
        <img
          class="photo-band__media"
          src="/img/hero.jpg"
          alt="A grayscale coastline at dusk: fog-layered hills behind waves breaking over dark rocks."
          fetchpriority="high"
        />
        <div class="photo-band__overlay" aria-hidden="true"></div>
        <div class="photo-band__inner">
          <h1 class="hero__name">{person.name}</h1>
          <p class="band__lede">
            {currentRole.title} at <strong>{currentRole.employer}</strong>
          </p>
          <a class="hero__scroll-cue" href="#about" aria-label="Scroll to the About section">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
        </div>
      </section>

      <section id="about" tabindex="-1" class="band" aria-labelledby="about-heading">
        <div class="band__inner reveal">
          <h2 id="about-heading">About</h2>
          <p class="band__meta">
            {person.location}
            {person.education && (
              <>
                {' '}&middot;{' '}
                {person.education.credential},{' '}
                {educationUrl ? (
                  <a href={educationUrl} rel="noopener" target="_blank">
                    {person.education.institution}
                  </a>
                ) : (
                  person.education.institution
                )}
              </>
            )}
          </p>
          <div class="band__prose">
            {about.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
      </section>

      <section id="experience" tabindex="-1" class="band" aria-labelledby="experience-heading">
        <div class="band__inner reveal">
          <h2 id="experience-heading">Experience</h2>
          <div class="timeline">
            {experience.map((job) => (
              <article
                class:list={['experience-entry', { 'experience-entry--current': !job.end }]}
              >
                <span class="experience-entry__marker" aria-hidden="true"></span>
                <div>
                  <p class="experience-entry__meta">
                    <time datetime={job.start}>{formatDateRange(job.start, job.end)}</time> &middot; {job.location}
                    {!job.end && <span class="experience-entry__current-tag">Current</span>}
                  </p>
                  <h3>{job.title}</h3>
                  <p class="experience-entry__employer">{job.employer}</p>
                  <ul>
                    {job.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="projects" tabindex="-1" class="band" aria-labelledby="projects-heading">
        <div class="band__inner reveal">
          <h2 id="projects-heading">Projects</h2>

          <div class="projects-featured">
            {featuredProjects.map((project) => (
              <article
                class="project-card"
                id={`project-${project.slug}`}
                aria-labelledby={`project-${project.slug}-heading`}
              >
                <h3 id={`project-${project.slug}-heading`} class="project-card__name">
                  {project.name}
                </h3>
                {project.period && <p class="project-card__period">{project.period}</p>}
                <p class="project-card__summary">{project.summary}</p>
                {project.outcome && <p class="project-card__outcome">{project.outcome}</p>}
                <ul class="project-card__bullets">
                  {project.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
                <ul class="project-card__stack" aria-label="Technology stack">
                  {project.stack.map((item) => (
                    <li class="stack-item">{item}</li>
                  ))}
                </ul>
                {project.links && project.links.length > 0 && (
                  <p class="project-card__links">
                    {project.links.map((link) => (
                      <a href={link.url} rel="noopener" target="_blank">
                        {link.label}
                      </a>
                    ))}
                  </p>
                )}
              </article>
            ))}
          </div>

          {projectGroups.map((group) => group.items.length > 0 && (
            <div class="projects-other">
              <p class="projects-other__label">{group.label}</p>
              <div class="projects-other-list">
                {group.items.map((project) => (
                  <article
                    class="project-row"
                    id={`project-${project.slug}`}
                    aria-labelledby={`project-${project.slug}-heading`}
                  >
                    <h3 id={`project-${project.slug}-heading`} class="project-row__name">
                      {project.name}
                    </h3>
                    {project.period && <p class="project-row__period">{project.period}</p>}
                    <p class="project-row__summary">{project.summary}</p>
                    {project.outcome && (
                      <p class="project-row__outcome">{project.outcome}</p>
                    )}
                    {project.bullets && project.bullets.length > 0 && (
                      <ul class="project-row__bullets">
                        {project.bullets.map((bullet) => (
                          <li>{bullet}</li>
                        ))}
                      </ul>
                    )}
                    <div class="project-row__meta">
                      <ul class="project-card__stack" aria-label="Technology stack">
                        {project.stack.map((item) => (
                          <li class="stack-item">{item}</li>
                        ))}
                      </ul>
                      {project.links && project.links.length > 0 && (
                        <p class="project-row__links">
                          {project.links.map((link) => (
                            <a href={link.url} rel="noopener" target="_blank">
                              {link.label}
                            </a>
                          ))}
                        </p>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="contact" tabindex="-1" class="photo-band" aria-labelledby="contact-heading">
        <img
          class="photo-band__media"
          src="/img/contact.jpg"
          alt="A grayscale sea stack rising from a beach at low tide, waves receding around it."
          loading="lazy"
          decoding="async"
        />
        <div class="photo-band__overlay" aria-hidden="true"></div>
        <div class="photo-band__inner">
          <h2 id="contact-heading">Get in Touch</h2>
          <p class="band__lede">
            <a href={`mailto:${person.email}`}>{person.email}</a>
          </p>
          <nav class="contact-links" aria-label="Social profiles">
            {validatedProfiles.map((profileLink) => (
              <a href={profileLink.url} rel="me noopener" target="_blank">
                {profileLink.label}
              </a>
            ))}
          </nav>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      {/*
        A real link, not a <p>. Below 480px the header's brand link
        (also href="#") disappears and this is the only in-page way
        back to the top - see the collapse comment above
        .site-nav-bar__brand in tokens.css and the fuller rationale on
        .site-footer__name there.
      */}
      <a class="site-footer__name" href="#">{person.name}</a>
      {/*
        Duplicates the header's .site-nav section links. Below 960px
        the header hides that copy (no room for it beside the brand and
        the resume/agent-view utility group - see tokens.css's
        .site-nav-bar__inner comment), and this one becomes visible in
        its place, so the same five destinations stay reachable without
        JS at every viewport width.
      */}
      <nav aria-label="Footer" class="site-footer__nav">
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
      <p class="site-footer__contact">
        <a href={`mailto:${person.email}`}>{person.email}</a>
      </p>
    </footer>

    <script>
      import { initViewToggle } from '../lib/viewToggle'
      import { initNavMenu } from '../lib/navMenu'
      initViewToggle(document)
      initNavMenu(document)
    </script>
  </body>
</html>
